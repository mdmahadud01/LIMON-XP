# Set these as environment variables in your hosting provider. Do not commit real secrets.
BOT_TOKEN=YOUR_BOTFATHER_TOKEN
# Recommended numeric Telegram USER ID (not username/bot ID).
# Optional: without it, pair once using /claim CODE from deployment logs.
TELEGRAM_OWNER_ID=
DATA_DIR=/data
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_SECRET
# Optional: match the browser that supplied the Quotex tokens.
QUOTEX_USER_AGENT=Mozilla/5.0
# Optional: public UI email/OTP features need your own Gmail credentials.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# PORT is injected by Railway; local default is 5000.
